<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titolo %></title>
<meta name="description" content="<%= descrizione %>">
<link rel="canonical" href="<%= canonico %>">
<%# Verifica della proprieta del sito per Google Search Console. Google la
    controlla sulla home, ma il tag sta nel partial condiviso cosi resta su
    tutte le pagine: se un domani si verifica un sottopercorso o si cambia
    l'impaginazione della home, la verifica non decade in silenzio. Non e un
    dato riservato, e pubblico nell'HTML di chiunque visiti il sito. %>
<meta name="google-site-verification" content="j_lo4dfiCd4wq7JrG_j0p1eD-2Q7zyasHK7FZhxKIOs">
<% if (typeof noindex !== 'undefined' && noindex) { %>
<meta name="robots" content="noindex, follow">
<% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= sito.nome %>">
<meta property="og:locale" content="<%= sito.locale %>">
<meta property="og:title" content="<%= titolo %>">
<meta property="og:description" content="<%= descrizione %>">
<meta property="og:url" content="<%= canonico %>">
<meta name="twitter:card" content="summary">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌾</text></svg>">
<link rel="stylesheet" href="/stile.css">
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
<% (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).forEach(function (blocco) { %>
<script type="application/ld+json"><%- JSON.stringify(blocco) %></script>
<% }); %>
<% } %>
</head>
<body>
<a class="salta" href="#contenuto">Salta al contenuto</a>
<header class="intestazione">
  <div class="contenitore intestazione__interno">
    <a class="marchio" href="/"><span aria-hidden="true">🌾</span> <%= sito.nome %></a>
    <nav aria-label="Navigazione principale">
      <a href="/colture">Colture</a>
      <a href="/metodologia">Metodologia</a>
    </nav>
  </div>
</header>
<main id="contenuto">
