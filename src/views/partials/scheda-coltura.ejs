<%
  // r: risultato arricchito da matching.suggerisci
  const aff = etichettaAffidabilita(r.coltura.affidabilita);
  const c = r.coltura;
%>
<article class="scheda <%= r.conRiserva ? 'scheda--riserva' : '' %>">
  <header class="scheda__testa">
    <h3 class="scheda__titolo">
      <a href="/colture/<%= c.slug %>"><%= c.nome %></a>
    </h3>
    <p class="scheda__sottotitolo">
      <em><%= c.nome_scientifico %></em> · <%= c.categoria %>
    </p>
    <p class="etichette">
      <span class="etichetta etichetta--<%= c.affidabilita %>" title="<%= aff.titolo %>"><%= aff.breve %></span>
      <span class="etichetta">Irrigazione: <%= etichetteIrrigazione[c.irrigazione] %></span>
      <% if (c.ciclo === 'poliennale') { %><span class="etichetta">Poliennale</span><% } %>
      <% if (c.contratto_filiera) { %><span class="etichetta etichetta--contratto">Da contratto</span><% } %>
      <% if (r.conRiserva) { %><span class="etichetta etichetta--riserva">Con riserva</span><% } %>
    </p>
  </header>

  <div class="plv">
    <div class="plv__blocco">
      <p class="plv__etichetta">PLV per ettaro</p>
      <p class="plv__valore"><%= formattaEuro(r.plvHa.tipica) %><span class="plv__unita">/ha</span></p>
      <p class="plv__range">
        annata scarsa <%= formattaEuro(r.plvHa.scarsa) %> · buona <%= formattaEuro(r.plvHa.buona) %>
      </p>
    </div>
    <div class="plv__blocco plv__blocco--totale">
      <p class="plv__etichetta">Margine lordo per ettaro</p>
      <p class="plv__valore"><%= formattaEuro(r.margineHa) %><span class="plv__unita">/ha</span></p>
      <p class="plv__range">
        costi indicativi <%= formattaEuro(c.costi_eur_ha) %>/ha
      </p>
    </div>
  </div>

  <div class="bilancio">
    <div class="bilancio__voce">
      <span class="bilancio__etichetta">Su <%= formattaEttari(r.superficieConsiderataHa) %></span>
      <span class="bilancio__valore"><%= formattaEuro(r.margineTotale) %> <span class="bilancio__nota">di margine</span></span>
    </div>
    <div class="bilancio__voce">
      <span class="bilancio__etichetta">Manodopera</span>
      <span class="bilancio__valore"><%= formattaNumero(r.oreTotali) %> h <span class="bilancio__nota"><%= c.manodopera_ore_ha %> h/ha</span></span>
    </div>
    <div class="bilancio__voce">
      <span class="bilancio__etichetta">Margine per ora</span>
      <span class="bilancio__valore"><%= formattaEuro(c.margine_eur_ora) %><span class="bilancio__nota">/h</span></span>
    </div>
  </div>

  <dl class="dettagli">
    <div>
      <dt>Resa tipica</dt>
      <dd><%= formattaNumero(c.resa_q_ha.tipica) %> <%= c.unita_resa_speciale ? 'pz/ha' : 'q/ha' %></dd>
    </div>
    <div>
      <dt>Prezzo tipico</dt>
      <dd><%= formattaNumero(c.prezzo_eur_q.tipico) %> <%= c.unita_prezzo_speciale ? '€/pz' : '€/q' %></dd>
    </div>
    <div>
      <dt>pH ottimale</dt>
      <dd><%= formattaNumero(c.ph.ottimale_min) %>–<%= formattaNumero(c.ph.ottimale_max) %></dd>
    </div>
    <div>
      <dt>Terreni adatti</dt>
      <dd><%= c.terreni.join(', ') %></dd>
    </div>
    <div>
      <dt>Salinita tollerata</dt>
      <dd><%= c.tolleranza_salinita %></dd>
    </div>
    <% if (c.investimento_impianto_eur_ha) { %>
    <div>
      <dt>Impianto</dt>
      <dd><%= formattaEuro(c.investimento_impianto_eur_ha) %>/ha · <%= c.anni_alla_produzione %> anni</dd>
    </div>
    <% } %>
    <% if (c.superficie_veneto_ha) { %>
    <div>
      <dt>Superficie in Veneto</dt>
      <dd><%= formattaEttari(c.superficie_veneto_ha) %></dd>
    </div>
    <% } %>
  </dl>

  <% if (r.motivi && r.motivi.length) { %>
    <p class="motivi"><% r.motivi.forEach(function (m, i) { %><%= i ? ' · ' : '' %><%= m %><% }); %></p>
  <% } %>

  <% if (r.avvertenze && r.avvertenze.length) { %>
    <details class="avvertenze">
      <summary><%= r.avvertenze.length %> <%= r.avvertenze.length === 1 ? 'avvertenza' : 'avvertenze' %> da leggere</summary>
      <ul>
        <% r.avvertenze.forEach(function (a) { %><li><%= a %></li><% }); %>
      </ul>
    </details>
  <% } %>

  <% if (c.indice_prezzi_corrente) { %>
    <p class="mercato">
      <span class="mercato__gruppo"><%= c.prezzo_gruppo_nome %></span>
      <% const i = c.indice_prezzi_corrente; %>
      <% if (i.scarto_da_picco <= -20) { %>
        prezzi in fase calante: indice <%= i.indice %> (base 2020 = 100), <%= Math.abs(i.scarto_da_picco) %>% sotto il picco recente.
      <% } else if (i.scarto_da_picco >= -5) { %>
        prezzi ai massimi recenti: indice <%= i.indice %> (base 2020 = 100).
      <% } else { %>
        indice prezzi <%= i.indice %> (base 2020 = 100), <%= Math.abs(i.scarto_da_picco) %>% sotto il picco recente.
      <% } %>
    </p>
  <% } %>

  <p class="scheda__metodo">
    PLV: <%= r.plvHa.metodo %>.
    Costi: <%= c.costi_fonte %>, stima di inquadramento.
  </p>
</article>
