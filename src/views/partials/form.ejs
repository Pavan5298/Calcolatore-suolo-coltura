<%
  // valori: { provincia, terreno, superficie, irrigazione, comune } - tutti opzionali
  const v = typeof valori !== 'undefined' && valori ? valori : {};
%>
<form class="form" action="/risultato" method="get">
  <div class="form__griglia">
    <p class="campo">
      <label for="comune">Comune <span class="campo__nota">(opzionale)</span></label>
      <select id="comune" name="comune">
        <option value="">— non specificato —</option>
        <% comuni.forEach(function (c) { %>
          <option value="<%= c.slug %>"
                  data-provincia="<%= c.provincia %>"
                  data-terreno="<%= c.terreno_prevalente %>"
                  <%= v.comune === c.slug ? 'selected' : '' %>><%= c.nome %> (<%= c.provincia %>)</option>
        <% }); %>
      </select>
      <span class="campo__aiuto">Precompila provincia e terreno tipico della zona.</span>
    </p>

    <p class="campo">
      <label for="provincia">Provincia</label>
      <select id="provincia" name="provincia" required>
        <% province.forEach(function (p) { %>
          <option value="<%= p.slug %>" <%= v.provincia === p.slug ? 'selected' : '' %>><%= p.nome %></option>
        <% }); %>
      </select>
      <span class="campo__aiuto">I dati di resa ISTAT hanno granularita provinciale.</span>
    </p>

    <p class="campo">
      <label for="terreno">Tipo di terreno</label>
      <select id="terreno" name="terreno" required>
        <% terreni.forEach(function (t) { %>
          <option value="<%= t %>" <%= v.terreno === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
        <% }); %>
      </select>
      <span class="campo__aiuto">Tessitura prevalente dell'appezzamento.</span>
    </p>

    <p class="campo">
      <label for="superficie">Superficie (ettari)</label>
      <input id="superficie" name="superficie" type="number" inputmode="decimal"
             min="0.1" max="5000" step="0.1" required
             value="<%= v.superficie != null ? v.superficie : superficiePredefinita %>">
      <span class="campo__aiuto">Superficie disponibile, anche parziale.</span>
    </p>
  </div>

  <p class="campo campo--interruttore">
    <label for="irrigazione">
      <input id="irrigazione" name="irrigazione" type="checkbox" value="si" <%= v.irrigazione ? 'checked' : '' %>>
      <span>Irrigazione disponibile</span>
    </label>
    <span class="campo__aiuto">Cambia in modo sostanziale le colture proponibili.</span>
  </p>

  <p class="form__azioni">
    <button type="submit">Calcola le colture adatte</button>
  </p>
</form>

<script>
  // Miglioramento progressivo: il form funziona identico senza JavaScript,
  // perche la risoluzione comune -> provincia la fa comunque il server.
  (function () {
    var comune = document.getElementById('comune');
    var provincia = document.getElementById('provincia');
    var terreno = document.getElementById('terreno');
    if (!comune || !provincia || !terreno) return;

    var slugPerSigla = <%- JSON.stringify(Object.fromEntries(province.map(function (p) { return [p.sigla, p.slug]; }))) %>;

    comune.addEventListener('change', function () {
      var scelto = comune.options[comune.selectedIndex];
      var sigla = scelto.getAttribute('data-provincia');
      if (slugPerSigla[sigla]) provincia.value = slugPerSigla[sigla];
      var tessitura = scelto.getAttribute('data-terreno');
      if (tessitura) terreno.value = tessitura;
    });
  })();
</script>
