<%- include('partials/head') %>

<section class="eroe eroe--compatto">
  <div class="contenitore">
    <h1>
      Colture adatte a <%= luogo %><br>
      <span class="eroe__qualifica">
        <%= formattaEttari(criteri.superficieHa) %> · terreno <%= criteri.terreno %> ·
        <%= criteri.irrigazione ? 'con irrigazione' : 'senza irrigazione' %>
      </span>
    </h1>
  </div>
</section>

<% if (criteri.comune) { %>
<section class="contenitore">
  <p class="nota-zona">
    <strong><%= criteri.comune.nome %></strong> — <%= zone[criteri.comune.zona] %>
    Le rese ISTAT sono <strong>regionali</strong> (Veneto): comune e provincia
    servono a inquadrare zona, altimetria e comprensori, non aumentano la
    precisione del dato di resa.
  </p>
</section>
<% } %>

<section class="contenitore">
  <div class="profilo">
    <h2 class="profilo__titolo">Profilo del terreno considerato</h2>
    <dl class="dettagli">
      <div>
        <dt>Tessitura</dt>
        <dd>
          <%= criteri.tessitura.semplificata %><% if (criteri.tessitura.nomeUsda) { %>
            <span class="profilo__usda">(<%= criteri.tessitura.nomeUsda %>, USDA)</span>
          <% } %>
        </dd>
      </div>
      <div>
        <dt>Sabbia / limo / argilla</dt>
        <dd>
          <%= formattaNumero(criteri.tessitura.sabbia) %>% / <%= formattaNumero(criteri.tessitura.limo) %>% / <%= formattaNumero(criteri.tessitura.argilla) %>%
          <% if (!criteri.tessitura.valido) { %><span class="profilo__usda">valori tipici della classe</span><% } %>
        </dd>
      </div>
      <div>
        <dt>pH</dt>
        <dd><%= criteri.ph != null ? formattaNumero(criteri.ph) : 'non indicato' %></dd>
      </div>
      <div>
        <dt>Salinita</dt>
        <dd><%= criteri.salinita || 'non rilevata' %></dd>
      </div>
      <div>
        <dt>Calcare attivo</dt>
        <dd><%= criteri.calcare || 'non rilevato' %></dd>
      </div>
      <div>
        <dt>Drenaggio</dt>
        <dd><%= criteri.drenaggio || 'non valutato' %></dd>
      </div>
    </dl>
    <% if (noteTessitura && noteTessitura.length) { %>
      <ul class="profilo__note">
        <% noteTessitura.forEach(function (n) { %><li><%= n %></li><% }); %>
      </ul>
    <% } %>
    <% if (criteri.ph == null) { %>
      <p class="profilo__suggerimento">
        Non hai indicato il pH: e il parametro piu selettivo di tutti e senza di
        esso il consiglio resta generico. Se hai un'analisi del suolo, aggiungilo
        nei campi avanzati qui sotto.
      </p>
    <% } %>
  </div>
</section>

<section class="contenitore sezione">
  <h2><%= esito.principali.length %> colture compatibili su <%= esito.ammesse %> proponibili</h2>
  <% if (esito.sottoSoglia) { %>
    <p class="avviso">
      Con questi parametri del terreno restano poche colture proponibili. Non ne
      aggiungiamo altre per arrivare a tre: su questo suolo non starebbero in
      piedi. Se il vincolo e il pH, valuta con un agronomo una correzione
      (calcitazione o acidificazione) e riprova con il valore corretto.
    </p>
  <% } %>
  <% if (esito.conRiserva) { %>
    <p class="avviso">
      Con questi vincoli poche colture risultano pienamente compatibili. L'elenco
      include quindi anche colture segnate <strong>con riserva</strong>: proponibili
      solo verificando tessitura e drenaggio con un agronomo.
    </p>
  <% } %>
  <div class="schede">
    <% esito.principali.forEach(function (r) { %>
      <%- include('partials/scheda-coltura', { r: r }) %>
    <% }); %>
  </div>
</section>



<% if (esito.alternative && esito.alternative.length) { %>
<section class="contenitore sezione">
  <h2>Il resto del ventaglio: altre <%= esito.alternative.length %> colture proponibili</h2>
  <p class="sezione__testo">
    Le schede sopra sono le prime per punteggio complessivo, ma la scelta giusta
    dipende da quale risorsa ti manca. Se hai terra e non ore, guarda il
    <strong>margine per ettaro</strong>; se hai ore e non terra, il
    <strong>margine per ora</strong>. Sono spesso due classifiche diverse.
  </p>
  <div class="tabella-scorrevole">
    <table class="tabella">
      <caption>Margine lordo indicativo, PAC esclusa e costi di produzione dedotti.</caption>
      <thead>
        <tr>
          <th scope="col">Coltura</th>
          <th scope="col" class="num">Margine/ha</th>
          <th scope="col" class="num">Margine/ora</th>
          <th scope="col" class="num">Ore/ha</th>
          <th scope="col" class="num">Su <%= formattaEttari(criteri.superficieHa) %></th>
          <th scope="col">Vincoli</th>
        </tr>
      </thead>
      <tbody>
        <% esito.alternative.forEach(function (r) { %>
          <tr>
            <th scope="row"><a href="/colture/<%= r.coltura.slug %>"><%= r.coltura.nome %></a></th>
            <td class="num"><%= formattaEuro(r.margineHa) %></td>
            <td class="num"><%= formattaEuro(r.coltura.margine_eur_ora) %></td>
            <td class="num"><%= formattaNumero(r.coltura.manodopera_ore_ha) %></td>
            <td class="num"><%= formattaEuro(r.margineTotale) %></td>
            <td class="vincoli">
              <% if (r.coltura.ciclo === 'poliennale') { %><span class="etichetta">Impianto</span><% } %>
              <% if (r.coltura.contratto_filiera) { %><span class="etichetta etichetta--contratto">Contratto</span><% } %>
              <% if (r.coltura.superficie_veneto_ha && r.coltura.superficie_veneto_ha < 300) { %><span class="etichetta etichetta--sperimentale">Dato fragile</span><% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<section class="contenitore sezione">
  <h2>Modifica i parametri</h2>
  <%- include('partials/form', { valori: {
    provincia: criteri.provincia.slug,
    terreno: criteri.terreno,
    superficie: criteri.superficieHa,
    irrigazione: criteri.irrigazione,
    comune: criteri.comune ? criteri.comune.slug : null,
    sabbia: criteri.tessitura.valido ? criteri.tessitura.sabbia : null,
    limo: criteri.tessitura.valido ? criteri.tessitura.limo : null,
    argilla: criteri.tessitura.valido ? criteri.tessitura.argilla : null,
    ph: criteri.ph,
    salinita: criteri.salinita,
    calcare: criteri.calcare,
    drenaggio: criteri.drenaggio,
    manodopera: criteri.manodopera,
    orizzonte: criteri.orizzonte
  }, superficiePredefinita: criteri.superficieHa }) %>
</section>

<%- include('partials/piede') %>
